# Runtime logs and test output
log/
*.log

# Local shareable summary (generated for sharing, not source)
ringkasan-perubahan.txt

# Python bytecode
__pycache__/
*.py[cod]

# OS / editor files
.DS_Store
Thumbs.db
*.swp
