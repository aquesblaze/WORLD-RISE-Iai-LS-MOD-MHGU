# Build artifacts (regenerate with cargo forge build)
01_plugins/mhw_ls_rebuild/target/
*.nro
# The release NRO is shipped with the repo; diagnostic NROs stay ignored.
!01_plugins/mhw_ls_rebuild/mhw_ls_rebuild.nro
# The assembled mod bundle ships its own plugin NRO.
!Rise-LS-MHGU/romfs/nativeNX/plugins/mhw_ls_rebuild.nro

# Local caches. Keep only the generated header required by build.rs.
.cache/*
!.cache/mhw_ls_animation_port/
.cache/mhw_ls_animation_port/*
